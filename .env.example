# Appian Configuration
APPIAN_BASE_URL=https://your-workspace.appian.com
APPIAN_API_KEY=your_api_key_here

# Azure DevOps Configuration
ADO_ORG=your-org-name
ADO_PROJECT=ITCMS
ADO_PAT=your_personal_access_token
ADO_PIPELINE_ID=1

# AWS Configuration
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=your_account_id

# Environment
TARGET_ENV=dev
